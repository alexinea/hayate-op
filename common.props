<Project>

    <PropertyGroup>
        <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <NoWarn Condition=" '$(Configuration)' == 'Debug' ">$(NoWarn);NETSDK1138;NU1803</NoWarn>
        <NoWarn Condition=" '$(Configuration)' == 'Release' ">$(NoWarn);CS1591;NETSDK1138;NU1803</NoWarn>
    </PropertyGroup>

    <!-- 2.9 构建门禁：把 src 的「零警告」从声称变为可执行——任何编译器 / 分析器警告即构建失败。
         作用域恰好是 src：本文件只被 src/ 下的全部项目 Import —— 这里刻意不写死个数：G-12 加入
         分析器包时它漂过一次（10 → 11），靠人工维护的数字必然过期。tests/ 自 3.1 / A5-6 起另有
         一道同口径的门禁，落在 tests/Directory.Build.props，覆盖该目录下全部 16 个工程
         （13 测试 + 3 工具）；不并进本文件、也不放进 common.tests.props，是因为 tests/ 的 16 个
         工程里只有 4 个 Import 了 common.tests.props，逐个 Import 会在新增工程时被漏掉。全量
         非增量实测：Release 与 Debug 下 src 下的全部项目、各自全部 TFM 均 0 警告 0 错误。
         之所以要落到这里：`Extensions.Endpoints` 曾因 net10.0 的 ASPDEPR002（`WithOpenApi` 过时）
         静默产出 14 条诊断，而当时门禁只被人工对着 core 一个项目跑过 ⇒ 无强制执行的口径必然漂移。
         一次性绕过（仅限本地排障）：dotnet build <proj> /p:TreatWarningsAsErrors=false -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- 多 TFM XML 根治（Q1）：规范路径的 XML 文档只由最高代际产出；低代际构建的文档落在
         各自的 obj/$(TargetFramework)/ 下，作为该 TFM 资产随包分发（内容恰好是该代际的准确
         文档）。任何构建/打包序列结束后，规范 XML 都不再被低代际的最后一次构建覆盖——
         高代际独有成员（#if 分叉面）的文档不会丢失，此前 2.6/2.7 期间以手工 git restore 规避。 -->
    <PropertyGroup>
        <HayateTopTfm>net10.0</HayateTopTfm>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DocumentationFile Condition=" '$(TargetFramework)' == '$(HayateTopTfm)' ">$(AssemblyName).xml</DocumentationFile>
        <DocumentationFile Condition=" '$(TargetFramework)' != '$(HayateTopTfm)' ">$(BaseIntermediateOutputPath)$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>

    <Import Project="asset/props/target.feature.props"/>

    <Import Project="asset/props/package.props"/>

    <Import Project="asset/props/misc.props"/>

    <Import Project="asset/version.props"/>

</Project>